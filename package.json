{
  "name": "@geoblocks/elevation-profile",
  "version": "0.0.28",
  "license": "BSD-3-Clause",
  "repository": "github:geoblocks/elevation-profile",
  "type": "module",
  "main": "dist/elevation-profile.js",
  "types": "dist/elevation-profile.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "elevation-profile.ts",
    "dist/"
  ],
  "scripts": {
    "start": "vite",
    "prepack": "npm run build",
    "build": "rm -rf dist && vite build --mode lib",
    "build-demo": "vite build",
    "publish-demo": "rm -rf build && npm run build-demo && gh-pages -d build",
    "typecheck": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@lit-labs/observers": "2.1.0",
    "d3-array": "3.2.4",
    "d3-axis": "3.0.0",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@types/d3-array": "3.2.2",
    "@types/d3-axis": "3.0.6",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.11",
    "@types/d3-shape": "3.2.0",
    "@typescript/typescript6": "^6.0.2",
    "gh-pages": "6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0"
  }
}
